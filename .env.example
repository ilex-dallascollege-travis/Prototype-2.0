# Copy this file to .env and fill in your Alpaca PAPER Trading keys only.
# NEVER commit .env or paste real keys into chat.
ALPACA_API_KEY=your_paper_api_key_here
ALPACA_SECRET_KEY=your_paper_secret_key_here

# Hard safety lock: Stage 1 only supports paper trading.
# Live trading requires BOTH a CLI flag AND this env var (disabled in Stage 1).
PROTOTYPE2_ALLOW_LIVE=false
